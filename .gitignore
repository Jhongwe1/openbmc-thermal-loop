# ── 個人計畫文件,不公開 ───────────────────────────
plan/
archive/

# ── 建置產物 ───────────────────────────────────────
build/
builddir/
*.o
*.a
*.so

# ── Python ────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# `pip install -e .` 產生的中繼資料目錄，是建置產物不是原始碼
*.egg-info/

# ── QEMU 映像(數百 MB,不進 git),但 manifest 是證據要留 ──
images/**
# 下一行先把「目錄」重新納入,否則 manifest 的例外不會生效
# (git 規則:父目錄被排除後,裡面的檔案無法用 ! 救回來)
!images/**/
!images/**/*.manifest
*.mtd

# ── meson subprojects:只留 .wrap,不收上游原始碼 ──
subprojects/*/
!subprojects/*.wrap

# ── 編輯器 / OS ───────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ⚠️ 刻意「不」忽略的東西(別手癢加進來):
#   bench/data/*.csv  ← 原始量測數據是「證據」,必須進 git
#   figures/*.png     ← 六張圖是交付物

# ── 私人複習紀錄(答錯的紀錄,先不公開) ──────────
study/
