					reg = <0x5000 0x1000>;
					#address-cells = <0x03>;
					#size-cells = <0x00>;
					clocks = <0x02 0x28>;
					pinctrl-names = "default";
					pinctrl-0 = <0x4c>;
					interrupts = <0x00 0x69 0x04>;
					aspeed,global-regs = <0x49 0x03>;
					status = "disabled";
				};

				i3c@6000 {
					compatible = "aspeed,ast2600-i3c";
					reg = <0x6000 0x1000>;
					#address-cells = <0x03>;
					#size-cells = <0x00>;
					clocks = <0x02 0x29>;
					pinctrl-names = "default";
					pinctrl-0 = <0x4d>;
					interrupts = <0x00 0x6a 0x04>;
					aspeed,global-regs = <0x49 0x04>;
					status = "disabled";
				};

				i3c@7000 {
					compatible = "aspeed,ast2600-i3c";
					reg = <0x7000 0x1000>;
					#address-cells = <0x03>;
					#size-cells = <0x00>;
					clocks = <0x02 0x2a>;
					pinctrl-names = "default";
					pinctrl-0 = <0x4e>;
					interrupts = <0x00 0x6b 0x04>;
					aspeed,global-regs = <0x49 0x05>;
					status = "disabled";
				};
			};

			fsi@1e79b000 {
				#interrupt-cells = <0x01>;
				compatible = "aspeed,ast2600-fsi-master";
				reg = <0x1e79b000 0x94>;
				interrupts = <0x00 0x64 0x04>;
				pinctrl-names = "default";
				pinctrl-0 = <0x4f>;
				clocks = <0x02 0x2d>;
				interrupt-controller;
				status = "disabled";
			};

			fsi@1e79b100 {
				#interrupt-cells = <0x01>;
				compatible = "aspeed,ast2600-fsi-master";
				reg = <0x1e79b100 0x94>;
				interrupts = <0x00 0x65 0x04>;
				pinctrl-names = "default";
				pinctrl-0 = <0x50>;
				clocks = <0x02 0x2d>;
				interrupt-controller;
				status = "disabled";
			};
		};
	};

	chosen {
		linux,initrd-end = <0x8ffff7d3>;
		linux,initrd-start = <0x8ce44000>;
		bootargs = "console=ttyS4,57600n8 root=/dev/ram rw vmalloc=768M";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x3f000000>;
	};

	iio-hwmon {
		compatible = "iio-hwmon";
		io-channels = <0x51 0x00 0x51 0x01 0x51 0x02 0x51 0x03 0x51 0x04 0x51 0x05 0x51 0x06 0x51 0x07 0x52 0x00 0x52 0x01 0x52 0x02 0x52 0x03 0x52 0x04 0x52 0x05 0x52 0x06 0x52 0x07>;
	};

	spi {
		compatible = "spi-gpio";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		sck-gpios = <0x32 0xcb 0x00>;
		mosi-gpios = <0x32 0xcc 0x00>;
		miso-gpios = <0x32 0xcd 0x00>;
		num-chipselects = <0x01>;
		cs-gpios = <0x32 0xc8 0x01>;

		tpm@0 {
			compatible = "infineon,slb9670\0tcg,tpm_tis-spi";
			spi-max-frequency = <0x1f78a40>;
			reg = <0x00>;
		};
	};

	front_gpio_leds {
		compatible = "gpio-leds";

		led-0 {
			label = "sys_log_id";
			default-state = "off";
			gpios = <0x53 0x00 0x01>;
		};
	};

	fan_gpio_leds {
		compatible = "gpio-leds";

		led-0 {
			label = "fan0_blue";
			retain-state-shutdown;
			default-state = "on";
			gpios = <0x54 0x08 0x00>;
		};

		led-1 {
			label = "fan1_blue";
			retain-state-shutdown;
			default-state = "on";
			gpios = <0x54 0x09 0x00>;
		};

		led-2 {
			label = "fan2_blue";
			retain-state-shutdown;
			default-state = "on";
			gpios = <0x54 0x0a 0x00>;
		};

		led-3 {
			label = "fan3_blue";
			retain-state-shutdown;
			default-state = "on";
			gpios = <0x54 0x0b 0x00>;
		};

		led-4 {
			label = "fan0_amber";
			retain-state-shutdown;
			default-state = "off";
			gpios = <0x54 0x0c 0x00>;
		};

		led-5 {
			label = "fan1_amber";
			retain-state-shutdown;
			default-state = "off";
			gpios = <0x54 0x0d 0x00>;
		};

		led-6 {
			label = "fan2_amber";
			retain-state-shutdown;
			default-state = "off";
			gpios = <0x54 0x0e 0x00>;
		};

		led-7 {
			label = "fan3_amber";
			retain-state-shutdown;
			default-state = "off";
			gpios = <0x54 0x0f 0x00>;
		};
	};

	sled1_gpio_leds {
		compatible = "gpio-leds";

		led-0 {
			label = "sled1_amber";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x55 0x00 0x01>;
		};

		led-1 {
			label = "sled1_blue";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x55 0x01 0x01>;
		};
	};

	sled2_gpio_leds {
		compatible = "gpio-leds";

		led-0 {
			label = "sled2_amber";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x56 0x00 0x01>;
		};

		led-1 {
			label = "sled2_blue";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x56 0x01 0x01>;
		};
	};

	sled3_gpio_leds {
		compatible = "gpio-leds";

		led-0 {
			label = "sled3_amber";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x57 0x00 0x01>;
		};

		led-1 {
			label = "sled3_blue";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x57 0x01 0x01>;
		};
	};

	sled4_gpio_leds {
		compatible = "gpio-leds";

		led-0 {
			label = "sled4_amber";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x58 0x00 0x01>;
		};

		led-1 {
			label = "sled4_blue";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x58 0x01 0x01>;
		};
	};

	sled5_gpio_leds {
		compatible = "gpio-leds";

		led-0 {
			label = "sled5_amber";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x59 0x00 0x01>;
		};

		led-1 {
			label = "sled5_blue";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x59 0x01 0x01>;
		};
	};

	sled6_gpio_leds {
		compatible = "gpio-leds";

		led-0 {
			label = "sled6_amber";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x5a 0x00 0x01>;
		};

		led-1 {
			label = "sled6_blue";
			retain-state-shutdown;
			default-state = "keep";
			gpios = <0x5a 0x01 0x01>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		presence-sled1-switch {
			label = "presence-sled1";
			gpios = <0x32 0x3a 0x01>;
			linux,code = <0x3a>;
		};

		presence-sled2-switch {
			label = "presence-sled2";
			gpios = <0x32 0x3b 0x01>;
			linux,code = <0x3b>;
		};

		presence-sled3-switch {
			label = "presence-sled3";
			gpios = <0x32 0x3c 0x01>;
			linux,code = <0x3c>;
		};

		presence-sled4-switch {
			label = "presence-sled4";
			gpios = <0x32 0x3d 0x01>;
			linux,code = <0x3d>;
		};

		presence-sled5-switch {
			label = "presence-sled5";
			gpios = <0x32 0x3e 0x01>;
			linux,code = <0x3e>;
		};

		presence-sled6-switch {
			label = "presence-sled6";
			gpios = <0x32 0x3f 0x01>;
			linux,code = <0x3f>;
		};
	};

	vbus_sled1 {
		compatible = "regulator-fixed";
		regulator-name = "vbus_sled1";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x5b 0x01 0x00>;
		enable-active-high;
		phandle = <0x33>;
	};

	vbus_sled2 {
		compatible = "regulator-fixed";
		regulator-name = "vbus_sled2";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x5c 0x01 0x00>;
		enable-active-high;
		phandle = <0x35>;
	};

	vbus_sled3 {
		compatible = "regulator-fixed";
		regulator-name = "vbus_sled3";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x5d 0x01 0x00>;
		enable-active-high;
		phandle = <0x37>;
	};

	vbus_sled4 {
		compatible = "regulator-fixed";
		regulator-name = "vbus_sled4";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x5e 0x01 0x00>;
		enable-active-high;
		phandle = <0x39>;
	};

	vbus_sled5 {
		compatible = "regulator-fixed";
		regulator-name = "vbus_sled5";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x5f 0x01 0x00>;
		enable-active-high;
		phandle = <0x3b>;
	};

	vbus_sled6 {
		compatible = "regulator-fixed";
		regulator-name = "vbus_sled6";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x60 0x01 0x00>;
		enable-active-high;
		phandle = <0x3d>;
	};
};
