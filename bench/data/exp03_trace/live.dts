/dts-v1/;

/memreserve/	0x000000008ce33000 0x000000000000e000;
/memreserve/	0x000000008ce44000 0x00000000031bb7d3;
/ {
	model = "Facebook Bletchley BMC";
	compatible = "facebook,bletchley-bmc\0aspeed,ast2600";
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;

	aliases {
		i2c0 = "/ahb/apb/bus@1e78a000/i2c@80";
		i2c1 = "/ahb/apb/bus@1e78a000/i2c@100";
		i2c2 = "/ahb/apb/bus@1e78a000/i2c@180";
		i2c3 = "/ahb/apb/bus@1e78a000/i2c@200";
		i2c4 = "/ahb/apb/bus@1e78a000/i2c@280";
		i2c5 = "/ahb/apb/bus@1e78a000/i2c@300";
		i2c6 = "/ahb/apb/bus@1e78a000/i2c@380";
		i2c7 = "/ahb/apb/bus@1e78a000/i2c@400";
		i2c8 = "/ahb/apb/bus@1e78a000/i2c@480";
		i2c9 = "/ahb/apb/bus@1e78a000/i2c@500";
		i2c10 = "/ahb/apb/bus@1e78a000/i2c@580";
		i2c11 = "/ahb/apb/bus@1e78a000/i2c@600";
		i2c12 = "/ahb/apb/bus@1e78a000/i2c@680";
		i2c13 = "/ahb/apb/bus@1e78a000/i2c@700";
		i2c14 = "/ahb/apb/bus@1e78a000/i2c@780";
		i2c15 = "/ahb/apb/bus@1e78a000/i2c@800";
		serial0 = "/ahb/apb/serial@1e783000";
		serial1 = "/ahb/apb/serial@1e78d000";
		serial2 = "/ahb/apb/serial@1e78e000";
		serial3 = "/ahb/apb/serial@1e78f000";
		serial4 = "/ahb/apb/serial@1e784000";
		serial5 = "/ahb/apb/serial@1e787000";
		serial6 = "/ahb/apb/serial@1e788000";
		mdio0 = "/ahb/mdio@1e650000";
		mdio1 = "/ahb/mdio@1e650008";
		mdio2 = "/ahb/mdio@1e650010";
		mdio3 = "/ahb/mdio@1e650018";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		enable-method = "aspeed,ast2600-smp";

		cpu@f00 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			reg = <0xf00>;
		};

		cpu@f01 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			reg = <0xf01>;
		};
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x0d 0x308 0x01 0x0e 0x308 0x01 0x0b 0x308 0x01 0x0a 0x308>;
		arm,cpu-registers-not-fw-configured;
		always-on;
	};

	sdram@1e6e0000 {
		compatible = "aspeed,ast2600-sdram-edac";
		reg = <0x1e6e0000 0x174>;
		interrupts = <0x00 0x00 0x04>;
	};

	ahb {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		device_type = "soc";
		ranges;

		interrupt-controller@40461000 {
			compatible = "arm,cortex-a7-gic";
			interrupts = <0x01 0x09 0x304>;
			#interrupt-cells = <0x03>;
			interrupt-controller;
			interrupt-parent = <0x01>;
			reg = <0x40461000 0x1000 0x40462000 0x1000 0x40464000 0x2000 0x40466000 0x2000>;
			phandle = <0x01>;
		};

		bus@1e600000 {
			compatible = "aspeed,ast2600-ahbc\0syscon";
			reg = <0x1e600000 0x100>;
			phandle = <0x1e>;
		};

		pwm-tach-controller@1e610000 {
			compatible = "aspeed,ast2600-pwm-tach";
			reg = <0x1e610000 0x100>;
			clocks = <0x02 0x33>;
			resets = <0x02 0x25>;
			#pwm-cells = <0x03>;
			status = "disabled";
		};

		spi@1e620000 {
			reg = <0x1e620000 0xc4 0x20000000 0x10000000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "aspeed,ast2600-fmc";
			clocks = <0x02 0x33>;
			status = "okay";
			interrupts = <0x00 0x27 0x04>;

			flash@0 {
				reg = <0x00>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				spi-rx-bus-width = <0x02>;
				status = "okay";
				m25p,fast-read;
				label = "bmc";

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					u-boot@0 {
						reg = <0x00 0xe0000>;
						label = "u-boot";
					};

					u-boot-env@e0000 {
						reg = <0xe0000 0x20000>;
						label = "u-boot-env";
					};

					kernel@100000 {
						reg = <0x100000 0x900000>;
						label = "kernel";
					};

					rofs@a00000 {
						reg = <0xa00000 0x5600000>;
						label = "rofs";
					};

					rwfs@6000000 {
						reg = <0x6000000 0x2000000>;
						label = "rwfs";
					};
				};
			};

			flash@1 {
				reg = <0x01>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				spi-rx-bus-width = <0x02>;
				status = "okay";
				m25p,fast-read;
				label = "alt-bmc";
			};

			flash@2 {
				reg = <0x02>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				spi-rx-bus-width = <0x02>;
				status = "disabled";
			};
		};

		spi@1e630000 {
			reg = <0x1e630000 0xc4 0x30000000 0x10000000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "aspeed,ast2600-spi";
			clocks = <0x02 0x33>;
			status = "disabled";

			flash@0 {
				reg = <0x00>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				spi-rx-bus-width = <0x02>;
				status = "disabled";
			};

			flash@1 {
				reg = <0x01>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				spi-rx-bus-width = <0x02>;
				status = "disabled";
			};
		};

		spi@1e631000 {
			reg = <0x1e631000 0xc4 0x50000000 0x10000000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "aspeed,ast2600-spi";
			clocks = <0x02 0x33>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x03>;

			flash@0 {
				reg = <0x00>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				spi-rx-bus-width = <0x02>;
				status = "okay";
				m25p,fast-read;
				label = "pnor";
			};

			flash@1 {
				reg = <0x01>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				spi-rx-bus-width = <0x02>;
				status = "disabled";
			};

			flash@2 {
				reg = <0x02>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				spi-rx-bus-width = <0x02>;
				status = "disabled";
			};
		};

		mdio@1e650000 {
			compatible = "aspeed,ast2600-mdio";
			reg = <0x1e650000 0x08>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x04>;
			resets = <0x02 0x23>;
		};

		mdio@1e650008 {
			compatible = "aspeed,ast2600-mdio";
			reg = <0x1e650008 0x08>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
			pinctrl-names = "default";
			pinctrl-0 = <0x05>;
			resets = <0x02 0x23>;
		};

		mdio@1e650010 {
			compatible = "aspeed,ast2600-mdio";
			reg = <0x1e650010 0x08>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
			pinctrl-names = "default";
			pinctrl-0 = <0x06>;
			resets = <0x02 0x23>;
		};

		mdio@1e650018 {
			compatible = "aspeed,ast2600-mdio";
			reg = <0x1e650018 0x08>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x07>;
			resets = <0x02 0x23>;
		};

		ethernet@1e660000 {
			compatible = "aspeed,ast2600-mac\0faraday,ftgmac100";
			reg = <0x1e660000 0x180>;
			interrupts = <0x00 0x02 0x04>;
			clocks = <0x02 0x12>;
			status = "disabled";
		};

		ethernet@1e680000 {
			compatible = "aspeed,ast2600-mac\0faraday,ftgmac100";
			reg = <0x1e680000 0x180>;
			interrupts = <0x00 0x03 0x04>;
			clocks = <0x02 0x13>;
			status = "disabled";
		};

		ethernet@1e670000 {
			compatible = "aspeed,ast2600-mac\0faraday,ftgmac100";
			reg = <0x1e670000 0x180>;
			interrupts = <0x00 0x20 0x04>;
			clocks = <0x02 0x14>;
			status = "okay";
			phy-mode = "rgmii";
			pinctrl-names = "default";
			pinctrl-0 = <0x08>;

			fixed-link {
				speed = <0x3e8>;
				full-duplex;
			};
		};

		ethernet@1e690000 {
			compatible = "aspeed,ast2600-mac\0faraday,ftgmac100";
			reg = <0x1e690000 0x180>;
			interrupts = <0x00 0x21 0x04>;
			clocks = <0x02 0x15>;
			status = "disabled";
		};

		usb@1e6a1000 {
			compatible = "aspeed,ast2600-ehci\0generic-ehci";
			reg = <0x1e6a1000 0x100>;
			interrupts = <0x00 0x05 0x04>;
			clocks = <0x02 0x0e>;
			pinctrl-names = "default";
			pinctrl-0 = <0x09>;
			status = "okay";
		};

		usb@1e6a3000 {
			compatible = "aspeed,ast2600-ehci\0generic-ehci";
			reg = <0x1e6a3000 0x100>;
			interrupts = <0x00 0x09 0x04>;
			clocks = <0x02 0x0f>;
			pinctrl-names = "default";
			pinctrl-0 = <0x0a>;
			status = "okay";
		};

		usb@1e6b0000 {
			compatible = "aspeed,ast2600-uhci\0generic-uhci";
			reg = <0x1e6b0000 0x100>;
			interrupts = <0x00 0x0a 0x04>;
			#ports = <0x02>;
			clocks = <0x02 0x0d>;
			status = "disabled";
		};

		usb-vhub@1e6a0000 {
			compatible = "aspeed,ast2600-usb-vhub";
			reg = <0x1e6a0000 0x350>;
			interrupts = <0x00 0x05 0x04>;
			clocks = <0x02 0x0e>;
			aspeed,vhub-downstream-ports = <0x07>;
			aspeed,vhub-generic-endpoints = <0x15>;
			pinctrl-names = "default";
			pinctrl-0 = <0x0b>;
			status = "disabled";
		};

		usb@1e6a2000 {
			compatible = "aspeed,ast2600-udc";
			reg = <0x1e6a2000 0x300>;
			interrupts = <0x00 0x09 0x04>;
			clocks = <0x02 0x0f>;
			pinctrl-names = "default";
			pinctrl-0 = <0x0c>;
			status = "disabled";
		};

		apb {
			compatible = "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;

			crypto@1e6d0000 {
				compatible = "aspeed,ast2600-hace";
				reg = <0x1e6d0000 0x200>;
				interrupts = <0x00 0x04 0x04>;
				clocks = <0x02 0x09>;
				resets = <0x02 0x04>;
			};

			syscon@1e6e2000 {
				compatible = "aspeed,ast2600-scu\0syscon\0simple-mfd";
				reg = <0x1e6e2000 0x1000>;
				ranges = <0x00 0x1e6e2000 0x1000>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				#clock-cells = <0x01>;
				#reset-cells = <0x01>;
				phandle = <0x02>;

				pinctrl {
					compatible = "aspeed,ast2600-pinctrl";
					phandle = <0x1f>;

					adc0_default {
						function = "ADC0";
						groups = "ADC0";
						phandle = <0x0e>;
					};

					adc1_default {
						function = "ADC1";
						groups = "ADC1";
						phandle = <0x0f>;
					};

					adc10_default {
						function = "ADC10";
						groups = "ADC10";
						phandle = <0x18>;
					};

					adc11_default {
						function = "ADC11";
						groups = "ADC11";
						phandle = <0x19>;
					};

					adc12_default {
						function = "ADC12";
						groups = "ADC12";
						phandle = <0x1a>;
					};

					adc13_default {
						function = "ADC13";
						groups = "ADC13";
						phandle = <0x1b>;
					};

					adc14_default {
						function = "ADC14";
						groups = "ADC14";
						phandle = <0x1c>;
					};

					adc15_default {
						function = "ADC15";
						groups = "ADC15";
						phandle = <0x1d>;
					};

					adc2_default {
						function = "ADC2";
						groups = "ADC2";
						phandle = <0x10>;
					};

					adc3_default {
						function = "ADC3";
						groups = "ADC3";
						phandle = <0x11>;
					};

					adc4_default {
						function = "ADC4";
						groups = "ADC4";
						phandle = <0x12>;
					};

					adc5_default {
						function = "ADC5";
						groups = "ADC5";
						phandle = <0x13>;
					};

					adc6_default {
						function = "ADC6";
						groups = "ADC6";
						phandle = <0x14>;
					};

					adc7_default {
						function = "ADC7";
						groups = "ADC7";
						phandle = <0x15>;
					};

					adc8_default {
