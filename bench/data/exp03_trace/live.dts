				silicon-id@14 {
					compatible = "aspeed,ast2600-silicon-id\0aspeed,silicon-id";
					reg = <0x14 0x04 0x5b0 0x08>;
				};

				smp-memram@180 {
					compatible = "aspeed,ast2600-smpmem";
					reg = <0x180 0x40>;
				};

				interrupt-controller@560 {
					#interrupt-cells = <0x01>;
					compatible = "aspeed,ast2600-scu-ic0";
					reg = <0x560 0x04>;
					interrupts = <0x00 0x0c 0x04>;
					interrupt-controller;
					phandle = <0x0d>;
				};

				interrupt-controller@570 {
					#interrupt-cells = <0x01>;
					compatible = "aspeed,ast2600-scu-ic1";
					reg = <0x570 0x04>;
					interrupts = <0x00 0x29 0x04>;
					interrupt-controller;
				};
			};

			hwrng@1e6e2524 {
				compatible = "timeriomem_rng";
				reg = <0x1e6e2524 0x04>;
				period = <0x01>;
				quality = <0x64>;
			};

			display@1e6e6000 {
				compatible = "aspeed,ast2600-gfx\0syscon";
				reg = <0x1e6e6000 0x1000>;
				clocks = <0x02 0x08>;
				resets = <0x02 0x1a>;
				syscon = <0x02>;
				status = "disabled";
				interrupts = <0x00 0x0e 0x04>;
			};

			xdma@1e6e7000 {
				compatible = "aspeed,ast2600-xdma";
				reg = <0x1e6e7000 0x100>;
				clocks = <0x02 0x04>;
				resets = <0x02 0x19 0x02 0x1b>;
				reset-names = "device\0root-complex";
				interrupts-extended = <0x01 0x00 0x06 0x04 0x0d 0x02>;
				aspeed,pcie-device = "bmc";
				aspeed,scu = <0x02>;
				status = "disabled";
			};

			adc@1e6e9000 {
				compatible = "aspeed,ast2600-adc0";
				reg = <0x1e6e9000 0x100>;
				clocks = <0x02 0x35>;
				resets = <0x02 0x37>;
				interrupts = <0x00 0x2e 0x04>;
				#io-channel-cells = <0x01>;
				status = "okay";
				aspeed,int-vref-microvolt = <0x2625a0>;
				pinctrl-names = "default";
				pinctrl-0 = <0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15>;
				phandle = <0x51>;
			};

			adc@1e6e9100 {
				compatible = "aspeed,ast2600-adc1";
				reg = <0x1e6e9100 0x100>;
				clocks = <0x02 0x35>;
				resets = <0x02 0x37>;
				interrupts = <0x00 0x2e 0x04>;
				#io-channel-cells = <0x01>;
				status = "okay";
				aspeed,int-vref-microvolt = <0x2625a0>;
				pinctrl-names = "default";
				pinctrl-0 = <0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d>;
				phandle = <0x52>;
			};

			secure-boot-controller@1e6f2000 {
				compatible = "aspeed,ast2600-sbc";
				reg = <0x1e6f2000 0x1000>;
			};

			crypto@1e6fa000 {
				compatible = "aspeed,ast2600-acry";
				reg = <0x1e6fa000 0x400 0x1e710000 0x1800>;
				interrupts = <0x00 0xa0 0x04>;
				clocks = <0x02 0x10>;
				aspeed,ahbc = <0x1e>;
			};

			video@1e700000 {
				compatible = "aspeed,ast2600-video-engine";
